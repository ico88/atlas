# ===========================================================================
# ATLAS environment configuration (example).
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
# ===========================================================================

# --- Environment ---
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO

# --- Authentication (spec §15) ---
# JWT signing secret. MUST be set in production (else tokens reset on restart).
# Generate with:  openssl rand -hex 32
ATLAS_JWT_SECRET=
ATLAS_ACCESS_TOKEN_EXPIRE_MINUTES=720
# Optional bootstrap admin, created on first startup if it does not exist.
# Use a real email format (reserved TLDs like .local are rejected).
ATLAS_ADMIN_EMAIL=admin@example.com
ATLAS_ADMIN_PASSWORD=change-me-admin-password

# --- PostgreSQL ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=atlas

# --- Backend (composed from the values above) ---
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:change-me-in-production@postgres:5432/atlas
ATLAS_REDIS_URL=redis://redis:6379/0

# --- Task engine (spec §7, M3) ---
# Concurrency limits (0 = unlimited for that scope).
ATLAS_MAX_CONCURRENT_GLOBAL=0
ATLAS_MAX_CONCURRENT_PER_USER=0
ATLAS_MAX_CONCURRENT_PER_TYPE=0
# Retry policy: exponential backoff + jitter (no infinite loops).
ATLAS_TASK_MAX_RETRIES=3
ATLAS_RETRY_BACKOFF_BASE=0.5
ATLAS_RETRY_BACKOFF_MAX=30
ATLAS_RETRY_JITTER=0.2

# --- Local AI (spec §4, §9, M2) ---
# Ollama endpoint. Leave empty to disable Ollama (chat uses the echo fallback).
# Enable the Ollama container with:  docker compose --profile ai up -d
ATLAS_OLLAMA_URL=http://ollama:11434
# Preferred local model. Managed by the installer and the model scripts —
# prefer `./atlas model-update <name:tag>` over editing this by hand.
ATLAS_DEFAULT_MODEL=

# --- RAG / Memory (spec §6, M8) ---
# Retrieval uses a deterministic local embedder by default (offline, hermetic).
# Set true (with Ollama enabled) to use real embeddings from ATLAS_EMBEDDING_MODEL.
ATLAS_USE_OLLAMA_EMBEDDINGS=false
ATLAS_EMBEDDING_MODEL=nomic-embed-text
ATLAS_EMBEDDING_DIM=256
ATLAS_RAG_CHUNK_SIZE=800
ATLAS_RAG_CHUNK_OVERLAP=100
ATLAS_RAG_TOP_K=5

# --- Frontend ---
# Backend URL used by Next.js dev rewrites (production uses the Caddy proxy).
BACKEND_URL=http://backend:8000

# --- Reverse proxy (Caddy) ---
# The ONLY port setting most people need: the HOST port the app is reachable on.
# Caddy always listens on :80 inside the container; this maps a host port to it.
# Change it if 80 is busy, e.g. ATLAS_HTTP_PORT=8080 -> open http://<host>:8080
ATLAS_HTTP_PORT=80
ATLAS_HTTPS_PORT=443
# For a public domain with automatic HTTPS, edit infrastructure/caddy/Caddyfile
# (replace ":80" with your domain) — advanced, not needed for LAN use.

# ===========================================================================
# Node federation (spec §8, milestone M4)
# ===========================================================================

# --- Control plane side (set on the MANAGER host) ---
# Shared token nodes must present to register/heartbeat. Empty = open (dev only).
# Generate one with:  openssl rand -hex 32
ATLAS_NODE_JOIN_TOKEN=
# A node is considered offline if no heartbeat is received within this many seconds.
ATLAS_NODE_OFFLINE_AFTER_SECONDS=60

# --- Node side (set on each WORKER host, used by docker-compose.node.yml) ---
# URL of the control plane as reachable from the node (often an overlay IP).
ATLAS_CONTROL_PLANE_URL=http://host.docker.internal:80
# Must match ATLAS_NODE_JOIN_TOKEN on the control plane.
ATLAS_NODE_TOKEN=
# Stable logical id for this node (defaults to the hostname if left empty).
ATLAS_NODE_ID=
ATLAS_NODE_LABEL=worker-1
# Comma-separated capabilities, e.g. llm,embeddings,build,test,vision
ATLAS_NODE_CAPABILITIES=build,test
ATLAS_NODE_HEARTBEAT_INTERVAL=15
# How often the node polls the control plane for claimable tasks (seconds).
ATLAS_NODE_POLL_INTERVAL=3

# --- Node Setup UI & overlay network (ROADMAP PR 5) ---
# Local status/diagnostics page (published to 127.0.0.1 only). See node README.
ATLAS_NODE_SETUP_UI=true
ATLAS_NODE_SETUP_UI_PORT=8971
# One-time code guarding the Setup UI's mutating actions (generated by installer).
ATLAS_NODE_BOOTSTRAP_TOKEN=
# Overlay network for this node: none | zerotier | existing.
ATLAS_NETWORK_PROVIDER=none
# ZeroTier network id (16 hex chars) when ATLAS_NETWORK_PROVIDER=zerotier.
ATLAS_ZEROTIER_NETWORK_ID=
# Report "awaiting enrollment" until the control plane approves this node.
ATLAS_NODE_AWAIT_ENROLLMENT=false

# ===========================================================================
# Web tools (ROADMAP PR 15) — OFF by default (local-first).
# ===========================================================================
# Enable outbound web search + fetch for the AI. Keep false unless you want
# ATLAS to reach the internet.
ATLAS_WEB_TOOLS_ENABLED=false
# Search backend: none | searxng (self-hosted JSON API) | json.
ATLAS_WEB_SEARCH_PROVIDER=none
# SearXNG JSON endpoint, e.g. http://searxng:8080/search
ATLAS_WEB_SEARCH_URL=
ATLAS_WEB_SEARCH_API_KEY=
ATLAS_WEB_MAX_RESULTS=5
ATLAS_WEB_FETCH_TIMEOUT=10
# Hard cap on a fetched body (bytes) — SSRF/DoS guard.
ATLAS_WEB_FETCH_MAX_BYTES=2000000
# Allow private/loopback targets (dev only — enables SSRF; leave false in prod).
ATLAS_WEB_ALLOW_PRIVATE_IPS=false
# Comma-separated host suffixes. Allowlist (if set) wins; denylist always blocks.
ATLAS_WEB_DOMAIN_ALLOWLIST=
ATLAS_WEB_DOMAIN_DENYLIST=
