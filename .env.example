# ===========================================================================
# ATLAS environment configuration (example).
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
# ===========================================================================

# --- Environment ---
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO

# --- Authentication (spec §15) ---
# JWT signing secret. MUST be set in production (else tokens reset on restart).
# Generate with:  openssl rand -hex 32
ATLAS_JWT_SECRET=
ATLAS_ACCESS_TOKEN_EXPIRE_MINUTES=720
# Optional bootstrap admin, created on first startup if it does not exist.
# Use a real email format (reserved TLDs like .local are rejected).
ATLAS_ADMIN_EMAIL=admin@example.com
ATLAS_ADMIN_PASSWORD=change-me-admin-password

# --- PostgreSQL ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=atlas

# --- Backend (composed from the values above) ---
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:change-me-in-production@postgres:5432/atlas
ATLAS_REDIS_URL=redis://redis:6379/0

# --- Task engine (spec §7, M3) ---
# Concurrency limits (0 = unlimited for that scope).
ATLAS_MAX_CONCURRENT_GLOBAL=0
ATLAS_MAX_CONCURRENT_PER_USER=0
ATLAS_MAX_CONCURRENT_PER_TYPE=0
# Retry policy: exponential backoff + jitter (no infinite loops).
ATLAS_TASK_MAX_RETRIES=3
ATLAS_RETRY_BACKOFF_BASE=0.5
ATLAS_RETRY_BACKOFF_MAX=30
ATLAS_RETRY_JITTER=0.2

# --- Local AI (spec §4, §9, M2) ---
# Ollama endpoint. Leave empty to disable Ollama (chat uses the echo fallback).
# Enable the Ollama container with:  docker compose --profile ai up -d
ATLAS_OLLAMA_URL=http://ollama:11434
# Preferred local model (empty = auto-pick the first available). Pull it with:
#   docker compose exec ollama ollama pull llama3.2
ATLAS_DEFAULT_MODEL=

# --- Frontend ---
# Backend URL used by Next.js dev rewrites (production uses the Caddy proxy).
BACKEND_URL=http://backend:8000

# --- Reverse proxy (Caddy) ---
# Default ":80" serves plain HTTP for local development.
# For production set a real domain (e.g. atlas.example.com) to enable auto-HTTPS.
ATLAS_SITE_ADDRESS=:80
# Host ports the reverse proxy binds to. Change these if 80/443 are already in
# use on the host (e.g. ATLAS_HTTP_PORT=8080 -> open http://localhost:8080).
ATLAS_HTTP_PORT=80
ATLAS_HTTPS_PORT=443

# ===========================================================================
# Node federation (spec §8, milestone M4)
# ===========================================================================

# --- Control plane side (set on the MANAGER host) ---
# Shared token nodes must present to register/heartbeat. Empty = open (dev only).
# Generate one with:  openssl rand -hex 32
ATLAS_NODE_JOIN_TOKEN=
# A node is considered offline if no heartbeat is received within this many seconds.
ATLAS_NODE_OFFLINE_AFTER_SECONDS=60

# --- Node side (set on each WORKER host, used by docker-compose.node.yml) ---
# URL of the control plane as reachable from the node (often an overlay IP).
ATLAS_CONTROL_PLANE_URL=http://host.docker.internal:80
# Must match ATLAS_NODE_JOIN_TOKEN on the control plane.
ATLAS_NODE_TOKEN=
# Stable logical id for this node (defaults to the hostname if left empty).
ATLAS_NODE_ID=
ATLAS_NODE_LABEL=worker-1
# Comma-separated capabilities, e.g. llm,embeddings,build,test,vision
ATLAS_NODE_CAPABILITIES=build,test
ATLAS_NODE_HEARTBEAT_INTERVAL=15
