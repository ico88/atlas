# ATLAS reverse proxy.
# Only HTTPS/HTTP is exposed publicly; the backend, database and Redis stay on
# the internal Docker network (spec §13).
{$ATLAS_SITE_ADDRESS::80} {
	encode gzip

	# API and health probe are served by the backend.
	@backend path /api/* /health
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the Next.js frontend.
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
