#!/usr/bin/env bash
# ===========================================================================
# atlas — one-command operations for ATLAS.
#
#   ./atlas update            Update the whole stack transactionally: preflight,
#                             snapshot (settings+DB), pull, rebuild, migrate,
#                             health-check — and auto-rollback on failure. One
#                             clear result (completed / rolled-back / manual).
#   ./atlas update --resume   Re-run update after an interrupted attempt.
#   ./atlas update-status     Show the last update log.
#   ./atlas backup            Back up .env + a PostgreSQL dump to .atlas/backups.
#   ./atlas status            docker compose ps
#   ./atlas logs [service]    Tail logs
#   ./atlas model-update M    Pull model M, smoke-test it, then activate it
#                             (keeps the previous model for rollback).
#   ./atlas model-rollback    Re-activate the previous model.
#   ./atlas model-list        Show installed models and the active one.
#   ./atlas model-prune [--yes]  Remove installed models except the protected
#                             ones (active, rollback-previous, embedding).
#   ./atlas gpu-status        Show detected vs configured GPU backend and whether
#                             Ollama is actually running on the GPU.
#
# Settings and memory are safe across updates: `.env` is git-ignored (never
# overwritten by `git pull`) and PostgreSQL/Redis/Ollama data live in named
# Docker volumes that `up` preserves. A DB dump is taken before every update.
# ===========================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ROOT}/.env"
STATE_DIR="${ROOT}/.atlas/state"
BACKUP_DIR="${ROOT}/.atlas/backups"
LOCK_DIR="${ROOT}/.atlas/update.lock"
UPDATE_LOG="${STATE_DIR}/update.log"

# shellcheck source=/dev/null
source "${ROOT}/infrastructure/scripts/lib/atlas-lib.sh"
# shellcheck source=/dev/null
source "${ROOT}/infrastructure/scripts/lib/ollama.sh"
# shellcheck source=/dev/null
source "${ROOT}/infrastructure/scripts/lib/gpu.sh"

mkdir -p "$STATE_DIR" "$BACKUP_DIR"

# Use sudo for docker only if the current user can't reach the daemon directly.
SUDO=""
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
    SUDO="sudo"
  fi
fi
export SUDO
ATLAS_COMPOSE="$(atlas_compose_cmd "$ROOT")"
export ATLAS_COMPOSE

_compose() {
  # shellcheck disable=SC2086
  (cd "$ROOT" && $ATLAS_COMPOSE "$@")
}

http_port() { local p; p="$(get_env_var ATLAS_HTTP_PORT)"; echo "${p:-80}"; }

health_ok() {
  local port; port="$(http_port)"
  curl -fsS -o /dev/null "http://localhost:${port}/health" 2>/dev/null
}

wait_healthy() {
  local timeout="${1:-120}" waited=0
  until health_ok; do
    sleep 3; waited=$((waited + 3))
    [ "$waited" -ge "$timeout" ] && return 1
  done
  return 0
}

# --- backup ---------------------------------------------------------------
cmd_backup() {
  local ts stamp dir
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  dir="${BACKUP_DIR}/${ts}"
  mkdir -p "$dir"
  [ -f "$ENV_FILE" ] && cp "$ENV_FILE" "${dir}/env.bak"
  local pguser pgdb
  pguser="$(get_env_var POSTGRES_USER)"; pguser="${pguser:-atlas}"
  pgdb="$(get_env_var POSTGRES_DB)"; pgdb="${pgdb:-atlas}"
  if _compose exec -T postgres pg_dump -U "$pguser" "$pgdb" > "${dir}/atlas-db.sql" 2>/dev/null; then
    log "Database dump saved to ${dir}/atlas-db.sql"
  else
    warn "Could not dump the database (is it running?). Continuing."
  fi
  log "Backup at ${dir} (settings + DB). Data volumes are preserved by Docker."
  echo "$dir"
}

# --- update (transactional, ROADMAP PR 20) --------------------------------
update_preflight() {
  log "Preflight checks..."
  local ok=0
  if ! docker info >/dev/null 2>&1 && ! ${SUDO:-} docker info >/dev/null 2>&1; then
    err "Docker is not available."; ok=1
  fi
  if ! _compose config >/dev/null 2>&1; then
    err "docker compose configuration is invalid."; ok=1
  fi
  local avail_kb
  avail_kb="$(df -Pk "$ROOT" 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -n "$avail_kb" ] && [ "$avail_kb" -lt 2097152 ]; then
    err "Low disk space (<2GB free on $(dirname "$ROOT")). Free space and retry."; ok=1
  fi
  [ "$ok" -eq 0 ] && log "Preflight OK."
  return "$ok"
}

update_rollback() {
  local prev_rev="$1" pulled="$2"
  if [ "$pulled" -eq 1 ] && [ -n "$prev_rev" ] && [ -d "${ROOT}/.git" ]; then
    log "Reverting code to ${prev_rev}..."
    (cd "$ROOT" && git reset --hard "$prev_rev") || { err "Code revert failed."; return 1; }
  fi
  log "Rebuilding the previous version..."
  _compose up -d --build || { err "Rollback rebuild failed."; return 1; }
  wait_healthy 180 || return 1
  return 0
}

cmd_update() {
  local resume=0
  [ "${1:-}" = "--resume" ] && resume=1
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    if [ "$resume" -eq 1 ]; then
      warn "Resuming a previous update (stale lock cleared)."
      rmdir "$LOCK_DIR" 2>/dev/null || true
      mkdir "$LOCK_DIR" 2>/dev/null || true
    else
      err "Another update is in progress (lock: $LOCK_DIR). Use './atlas update --resume'."
      exit 1
    fi
  fi
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
  : > "$UPDATE_LOG"
  {
    log "ATLAS update starting ($(date -u +%FT%TZ))."
    local result="manual"

    if ! update_preflight; then
      result="aborted"
    else
      local prev_rev="" pulled=0
      [ -d "${ROOT}/.git" ] && prev_rev="$(cd "$ROOT" && git rev-parse HEAD 2>/dev/null || true)"

      log "Snapshot: backing up settings and database..."
      cmd_backup >/dev/null

      if [ -d "${ROOT}/.git" ]; then
        log "Fetching latest code (fast-forward only; .env is never touched)..."
        if (cd "$ROOT" && git pull --ff-only); then
          pulled=1
        else
          warn "git pull --ff-only skipped (local commits/conflicts). Keeping current code."
        fi
      fi

      # NEVER 'down -v'; 'up -d --build' preserves pgdata/redisdata/ollamadata.
      # Migrations run via the backend entrypoint on start.
      log "Rebuilding and migrating (data volumes preserved)..."
      if _compose up -d --build && wait_healthy 180; then
        [ -f "${STATE_DIR}/ollama.enabled" ] && { refresh_atlas_models && log "Model registry refreshed." || true; }
        result="completed"
      else
        warn "Update did not become healthy; rolling back..."
        if update_rollback "$prev_rev" "$pulled"; then result="rolled-back"; else result="manual"; fi
      fi
    fi

    echo ""
    case "$result" in
      completed)   log  "RESULT: completed — ATLAS is updated and operational." ;;
      rolled-back) warn "RESULT: rolled-back — update failed; previous version restored and healthy." ;;
      aborted)     err  "RESULT: aborted — preflight failed; nothing was changed." ;;
      *)           err  "RESULT: manual intervention needed — see './atlas logs backend' and './atlas update-status'." ;;
    esac
    echo "$result" > "${STATE_DIR}/last-result"
  } 2>&1 | tee -a "$UPDATE_LOG"

  local r; r="$(cat "${STATE_DIR}/last-result" 2>/dev/null || echo manual)"
  case "$r" in
    completed) return 0 ;;
    rolled-back|aborted) return 1 ;;
    *) return 2 ;;
  esac
}

cmd_update_status() {
  [ -f "$UPDATE_LOG" ] && cat "$UPDATE_LOG" || echo "No update has been run yet."
}

# --- model lifecycle (partial PR 3) --------------------------------------
cmd_model_update() {
  local model="${1:-}"
  [ -n "$model" ] || { err "Usage: ./atlas model-update <name:tag>"; exit 1; }
  validate_model_name "$model" || { err "Invalid model name '$model'"; exit 1; }

  local previous; previous="$(get_env_var ATLAS_DEFAULT_MODEL)"
  log "Active model: ${previous:-none}; requested: $model"

  if [ ! -f "${STATE_DIR}/ollama.enabled" ]; then
    err "Local AI (Ollama) is not enabled. Re-run the installer with --with-ollama."
    exit 1
  fi

  wait_for_ollama 60 || { err "Ollama is not reachable."; exit 1; }
  pull_model "$model" || { err "Pull failed; keeping '$previous' active."; exit 1; }
  if ! smoke_test_model "$model"; then
    err "Smoke test failed; keeping '$previous' active."
    exit 1
  fi

  # Activate only after a successful pull + smoke test.
  set_env_var ATLAS_DEFAULT_MODEL "$model" "$ENV_FILE"
  {
    echo "ACTIVE_MODEL=$model"
    echo "PREVIOUS_MODEL=$previous"
    echo "UPDATED_AT=$(date -u +%FT%TZ)"
  } > "${STATE_DIR}/models.env.tmp"
  mv "${STATE_DIR}/models.env.tmp" "${STATE_DIR}/models.env"

  log "Recreating backend to pick up ATLAS_DEFAULT_MODEL..."
  _compose up -d --no-deps backend worker

  if wait_healthy 120; then
    refresh_atlas_models || true
    log "Model '$model' is now active (previous: ${previous:-none}, kept for rollback)."
  else
    warn "Backend unhealthy after switch; rolling back to '${previous}'."
    set_env_var ATLAS_DEFAULT_MODEL "$previous" "$ENV_FILE"
    _compose up -d --no-deps backend worker
    exit 1
  fi
}

cmd_model_rollback() {
  local prev
  prev="$(get_env_var PREVIOUS_MODEL "${STATE_DIR}/models.env" 2>/dev/null || true)"
  [ -n "$prev" ] || { err "No previous model recorded in ${STATE_DIR}/models.env."; exit 1; }
  log "Rolling back to '$prev'..."
  set_env_var ATLAS_DEFAULT_MODEL "$prev" "$ENV_FILE"
  _compose up -d --no-deps backend worker
  wait_healthy 120 && log "Rolled back to '$prev'." || warn "Backend not healthy after rollback."
}

cmd_model_list() {
  echo "Active model: $(get_env_var ATLAS_DEFAULT_MODEL)"
  _compose exec -T ollama ollama list 2>/dev/null || warn "Ollama not running."
}

# Remove installed models except the protected ones (active, rollback-previous,
# embedding). Never removes a model ATLAS may still need.
cmd_model_prune() {
  local yes=0
  [ "${1:-}" = "--yes" ] && yes=1
  if [ ! -f "${STATE_DIR}/ollama.enabled" ]; then
    err "Local AI (Ollama) is not enabled."; exit 1
  fi
  wait_for_ollama 60 || { err "Ollama is not reachable."; exit 1; }

  local active prev embed
  active="$(get_env_var ATLAS_DEFAULT_MODEL)"
  prev="$(get_env_var PREVIOUS_MODEL "${STATE_DIR}/models.env" 2>/dev/null || true)"
  embed="$(get_env_var ATLAS_EMBEDDING_MODEL)"

  local victims
  victims="$(list_installed_models | models_to_prune "$active" "$prev" "$embed")"
  log "Protected: active='${active:-none}' previous='${prev:-none}' embedding='${embed:-none}'"
  if [ -z "$victims" ]; then
    log "Nothing to prune."
    return 0
  fi
  log "Models to remove:"
  printf '%s\n' "$victims" | sed 's/^/  - /'
  if [ "$yes" -ne 1 ]; then
    printf "Proceed with removal? [y/N] "
    read -r ans
    case "$ans" in y|Y|yes|YES) : ;; *) log "Aborted; nothing removed."; return 0 ;; esac
  fi
  local m
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    log "Removing '$m'..."
    _ollama rm "$m" || warn "Could not remove '$m'."
  done <<< "$victims"
  refresh_atlas_models || true
  log "Prune complete."
}

# Show detected vs configured GPU backend, and whether Ollama really uses the GPU.
cmd_gpu_status() {
  echo "Detected host backend:  $(detect_gpu_backend)"
  echo "Configured for Ollama:  $(gpu_backend_configured "$ROOT")"
  if [ -f "${STATE_DIR}/ollama.enabled" ] && wait_for_ollama 10; then
    if ollama_uses_gpu; then
      echo "Ollama runtime:         GPU in use ✅"
    else
      echo "Ollama runtime:         CPU (no model currently loaded on GPU)."
      echo "  Tip: send a chat message to load the model, then re-run this."
    fi
  else
    echo "Ollama runtime:         not running (enable with --with-ollama)."
  fi
}

usage() { sed -n '2,/^# ===/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  update) shift; cmd_update "${1:-}" ;;
  update-status) cmd_update_status ;;
  backup) cmd_backup >/dev/null ;;
  status) _compose ps ;;
  logs) shift; _compose logs -f "$@" ;;
  model-update) shift; cmd_model_update "${1:-}" ;;
  model-rollback) cmd_model_rollback ;;
  model-list) cmd_model_list ;;
  model-prune) shift; cmd_model_prune "${1:-}" ;;
  gpu-status) cmd_gpu_status ;;
  help|-h|--help) usage ;;
  *) err "Unknown command: $1"; usage; exit 1 ;;
esac
